    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.0.0",
