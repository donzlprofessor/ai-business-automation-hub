# Replace every placeholder with a distinct random value before starting.
# This file contains examples only. Never copy real credentials into it.
APP_DB_NAME=automation_hub
APP_DB_USER=hub_app
APP_DB_PASSWORD=replace-with-random-app-password
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=replace-with-different-random-n8n-password
N8N_ENCRYPTION_KEY=replace-with-random-64-character-hex-key
GENERIC_TIMEZONE=Europe/Warsaw
# JSON array of explicit browser origins. Never use '*'. Compose dashboard uses a same-origin proxy.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# External CRM/email credentials belong in n8n's credential store, never in VITE_*.
# No HubSpot or SMTP integration is configured by these example variables.
